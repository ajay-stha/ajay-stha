<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BajraTimeLog.Views"
    x:Class="BajraTimeLog.AppShell"
    FlyoutBehavior="Disabled"
    Shell.NavBarBackgroundColor="#1a237e"
    Shell.NavBarTextColor="White"
    Shell.TitleColor="White">

    <!-- Login page — shown by default on first launch -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Time log page — navigated to after successful login -->
    <ShellContent
        Route="timelog"
        ContentTemplate="{DataTemplate views:TimeLogPage}" />

</Shell>
